import torch
import pandas as pd
from datasets import Dataset
from transformers import (
    GPT2Tokenizer,
    GPT2LMHeadModel,
    DataCollatorForLanguageModeling,
    Trainer,
    TrainingArguments
)


df = pd.read_csv("squad_v2_output.csv")
df = df.dropna(subset=["answer_text"])

df["text"] = "Context: " + df["context"].astype(str) + "\nQuestion: " + df["question"].astype(str) + "\nAnswer: " + df["answer_text"].astype(str) + "<|endoftext|>"
# Convert pd to hf
raw_dataset = Dataset.from_pandas(df[["text"]]).train_test_split(test_size=0.1)


model_id = "gpt2"
tokenizer = GPT2Tokenizer.from_pretrained(model_id)
tokenizer.pad_token = tokenizer.eos_token

model = GPT2LMHeadModel.from_pretrained(model_id)
model.resize_token_embeddings(len(tokenizer))

# Tokenization
def tokenize(batch):
    return tokenizer(batch["text"], truncation=True, max_length=384, padding="max_length")

tokenized_dataset = raw_dataset.map(tokenize, batched=True, remove_columns=["text"])
data_collator = DataCollatorForLanguageModeling(tokenizer=tokenizer, mlm=False)

training_args = TrainingArguments(
    output_dir="./gpt2-cp",
    num_train_epochs=4,
    per_device_train_batch_size=4,
    per_device_eval_batch_size=4,
    gradient_accumulation_steps=2,
    learning_rate=0.00005,
    eval_strategy="epoch",
    save_strategy="epoch",
    fp16=torch.cuda.is_available(),
    logging_steps=10,
    report_to="none"
)

# Execute training
trainer = Trainer(
    model=model,
    args=training_args,
    train_dataset=tokenized_dataset["train"],
    eval_dataset=tokenized_dataset["test"],
    data_collator=data_collator,
)

trainer.train()

# fine-tuned weights and tokenizer
trainer.save_model("./gpt2-final")
tokenizer.save_pretrained("./gpt2-final")

import torch
from transformers import pipeline

# Load the fine-tuned SQuAD model and tokenizer
model_path = "/content/gpt2-final"
qa_generator = pipeline(
    "text-generation",
    model=model_path,
    tokenizer=model_path,
    device=0 if torch.cuda.is_available() else -1  # Uses GPU if available
)

# Define the context paragraph and your question (from SQuAD data)
context_text = 'The Normans (Norman: Nourmands; French: Normands; Latin: Normanni) were the people who in the 10th and 11th centuries gave their name to Normandy, a region in France. They were descended from Norse ("Norman" comes from "Norseman") raiders and pirates from Denmark, Iceland and Norway who, under their leader Rollo, agreed to swear fealty to King Charles III of West Francia.'
question = "In what country is Normandy located?"

# Format the prompt EXACTLY as it was structured in the training script
prompt = f"Context: {context_text}\nQuestion: {question}\nAnswer:"

# Generate the response
outputs = qa_generator(
    prompt,
    max_new_tokens=30,               # SQuAD answers are usually short phrases
    do_sample=False,                 # Use False (Greedy Search) for factual extraction
    repetition_penalty=1.2,
    pad_token_id=qa_generator.tokenizer.eos_token_id,
    eos_token_id=qa_generator.tokenizer.eos_token_id
)

# Extract and clean up only the generated answer
raw_text = outputs[0]["generated_text"]

# Split the string at "Answer:" and take everything after it
response = raw_text.split("Answer:")[-1]

for stop_marker in ["\n", " - ", "<|endoftext|>"]:
    response = response.split(stop_marker)[0].strip()

print(f"Context: {context_text}")
print(f"Question: {question}")
print(f"Answer: {response}")
